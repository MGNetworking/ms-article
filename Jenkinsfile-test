@Library('JenkinsLib_Shared') _

pipeline {
    agent any
    stages {

        stage('Maven Build') {
            agent {
                docker {
                    image 'maven:3.8.5-jdk-8-slim'
                    // mapping de jenkins vers le conteneur
                    args '-v /var/jenkins_home/settings.xml:/root/.m2/settings.xml -v /var/run/docker.sock:/var/run/docker.sock'
                }
            }
            steps {
                script {
                    sh '''
                        export CONFIG_SERVICE_URI_host="http://192.168.1.27:8089"
                        mvn clean package "-Dspring-boot.run.jvmArguments=-Dspring.profiles.active=dev"
                    '''
                }
            }
        }

        stage('Docker Build') {
            agent any
            steps {
                script {
                    // Accédez aux résultats du build précédent dans le dossier de travail
                    sh 'docker compose -f docker-compose-dev.yml build --no-cache'
                }
            }
        }
    }


    post {
        always {
            script {
                echo "Fin du test ..."
            }
        }
        success {
            echo 'Réussite du build'
        }
        failure {
            echo "Échec du build";

        }
    }

}